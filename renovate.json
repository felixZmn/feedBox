{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":disableDependencyDashboard"
    ],
    "labels": [
        "dependencies"
    ],
    "packageRules": [
        {
            "description": "Bundle all minor and patch updates into a single PR",
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "all non-major dependencies"
        }
    ],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "timezone": "Europe/Berlin"
}