# Database (required)
quarkus.datasource.jdbc.url=jdbc:postgresql://localhost:5432/postgres?user=user&password=password

# OIDC web-app session (required)
# auth-server-url is the IdP realm / application issuer (OIDC discovery base).
quarkus.oidc.auth-server-url=https://your-idp.example/application/o/your-app/
quarkus.oidc.client-id=your-client-id
# IdP Redirect URI must be exactly: http://localhost:8080/oidc

# Confidential clients: set the client secret.
# Public + PKCE clients: leave secret empty and set a stable 32+ char encryption
# secret so sessions survive restarts (and work across replicas).
# Confidential clients: set the client secret instead (or as well).
# quarkus.oidc.credentials.secret=your-client-secret
quarkus.oidc.token-state-manager.encryption-secret=change-me-to-at-least-32-chars!!
